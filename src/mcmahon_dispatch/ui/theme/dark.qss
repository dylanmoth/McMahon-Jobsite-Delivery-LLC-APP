QWidget { background: #0B1220; color: #E5E7EB; font-family: "Segoe UI"; font-size: 10pt; }
QMainWindow, QDialog { background: #0B1220; }
QFrame#sidebar { background: #111827; border-right: 1px solid #263244; }
QFrame#topbar { background: #111827; border-bottom: 1px solid #263244; }
QLabel#brandTitle { font-size: 16pt; font-weight: 700; color: #FFFFFF; }
QLabel#pageTitle { font-size: 20pt; font-weight: 700; color: #FFFFFF; }
QLabel#muted { color: #9CA3AF; }
QPushButton { background: #1F2937; border: 1px solid #374151; border-radius: 6px; padding: 8px 12px; }
QPushButton:hover { border-color: #F97316; }
QPushButton:focus { border: 2px solid #F97316; }
QPushButton#primary { background: #F97316; color: #111827; border: none; font-weight: 700; }
QPushButton#navButton { border: none; text-align: left; padding: 10px 14px; background: transparent; }
QPushButton#navButton:hover, QPushButton#navButton[active="true"] { background: #1F2937; color: #F97316; }
QLineEdit, QComboBox, QSpinBox { background: #111827; border: 1px solid #374151; border-radius: 6px; padding: 8px; }
QLineEdit:focus, QComboBox:focus { border: 2px solid #F97316; }
QFrame#metricCard { background: #111827; border: 1px solid #263244; border-radius: 10px; }
QLabel#metricValue { font-size: 22pt; font-weight: 700; color: #FFFFFF; }
QLabel#metricLabel { color: #9CA3AF; }
QStatusBar { background: #111827; color: #9CA3AF; }

/* Dashboard v0.3 */
QWidget#dashboardContent { background: #0B1220; }
QLabel#dashboardUpdated { color: #64748B; font-size: 9pt; }
QPushButton#secondaryCompact { padding: 7px 12px; border-radius: 8px; }
QFrame#metricCard {
    background: #111827;
    border: 1px solid #263244;
    border-radius: 12px;
}
QFrame#metricCard:hover { border-color: #475569; background: #151F2E; }
QFrame#metricAccent { border: none; border-top-left-radius: 12px; border-bottom-left-radius: 12px; background: #F97316; }
QFrame#metricAccent[accent="green"] { background: #22C55E; }
QFrame#metricAccent[accent="blue"] { background: #38BDF8; }
QFrame#metricAccent[accent="amber"] { background: #F59E0B; }
QFrame#metricAccent[accent="red"] { background: #EF4444; }
QLabel#metricLabel { color: #94A3B8; font-weight: 600; font-size: 9pt; }
QLabel#metricValue { color: #F8FAFC; font-size: 22pt; font-weight: 700; }
QLabel#metricHelper { color: #64748B; font-size: 8.5pt; }
QFrame#dashboardPanel {
    background: #111827;
    border: 1px solid #263244;
    border-radius: 12px;
}
QLabel#panelTitle { color: #F8FAFC; font-size: 12pt; font-weight: 700; }
QLabel#panelSubtitle { color: #64748B; font-size: 9pt; }
QPushButton#primaryAction {
    background: #F97316;
    color: #111827;
    border: none;
    border-radius: 9px;
    font-weight: 700;
    text-align: left;
    padding: 10px 14px;
}
QPushButton#primaryAction:hover { background: #FB923C; }
QPushButton#quickAction {
    background: #172033;
    border: 1px solid #2B3A50;
    border-radius: 9px;
    text-align: left;
    padding: 10px 14px;
    font-weight: 600;
}
QPushButton#quickAction:hover { border-color: #F97316; background: #1C293D; }
QFrame#notificationRow { background: #0F172A; border: 1px solid #1E293B; border-radius: 8px; }
QFrame#notificationRow:hover { border-color: #475569; }
QLabel#notificationMarker { color: #38BDF8; font-size: 10pt; }
QLabel#notificationMarker[severity="success"] { color: #22C55E; }
QLabel#notificationMarker[severity="warning"] { color: #F59E0B; }
QLabel#notificationMarker[severity="danger"] { color: #EF4444; }
QLabel#rowTitle { color: #E2E8F0; font-weight: 600; background: transparent; }
QLabel#rowSubtitle { color: #64748B; font-size: 8.5pt; background: transparent; }
QLabel#rowMeta { color: #64748B; font-size: 8.5pt; background: transparent; }
QPushButton#listRowButton {
    background: transparent;
    border: none;
    border-bottom: 1px solid #1E293B;
    border-radius: 0;
    text-align: left;
    padding: 0;
}
QPushButton#listRowButton:hover { background: #172033; }
QFrame#activityRow { background: transparent; border-bottom: 1px solid #1E293B; }
QLabel#activityMarker { color: #F97316; font-size: 15pt; background: transparent; }
QLabel#emptyState { color: #64748B; background: transparent; }
QScrollArea { border: none; background: #0B1220; }
QScrollBar:vertical { background: #0B1220; width: 11px; margin: 0; }
QScrollBar::handle:vertical { background: #334155; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #475569; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* Quote Builder v0.5 */
QGroupBox {
    background: #0F172A;
    border: 1px solid #263244;
    border-radius: 10px;
    margin-top: 13px;
    padding: 14px 10px 10px 10px;
    font-weight: 700;
    color: #F8FAFC;
}
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; color: #F97316; }
QTextEdit, QPlainTextEdit, QDoubleSpinBox, QDateTimeEdit {
    background: #111827;
    color: #E5E7EB;
    border: 1px solid #374151;
    border-radius: 6px;
    padding: 7px;
    selection-background-color: #F97316;
    selection-color: #111827;
}
QTextEdit:focus, QDoubleSpinBox:focus, QDateTimeEdit:focus { border: 2px solid #F97316; }
QTableWidget {
    background: #0B1220;
    alternate-background-color: #111827;
    border: 1px solid #263244;
    border-radius: 8px;
    gridline-color: #263244;
}
QHeaderView::section { background: #172033; color: #CBD5E1; border: none; border-bottom: 1px solid #334155; padding: 7px; font-weight: 700; }
QFrame#quoteSummary, QFrame#quickNotesPanel { background: #111827; border: 1px solid #263244; border-radius: 12px; }
QLabel#quoteNumber { color: #F97316; font-size: 12pt; font-weight: 700; }
QLabel#quoteTotal { color: #FFFFFF; font-size: 25pt; font-weight: 800; }
QFrame#quoteWarning { background: #0F172A; border: 1px solid #334155; border-radius: 8px; }
QFrame#quoteWarning[severity="warning"] { border-color: #92400E; background: #1C1917; }
QFrame#quoteWarning[severity="danger"] { border-color: #991B1B; background: #1F1115; }
QLabel#quoteWarningIcon { color: #38BDF8; font-weight: 800; font-size: 13pt; background: transparent; }
QLabel#quoteWarningIcon[severity="warning"] { color: #F59E0B; }
QLabel#quoteWarningIcon[severity="danger"] { color: #EF4444; }
QLabel#quoteWarningTitle { color: #F8FAFC; font-weight: 700; background: transparent; }
QLabel#quoteWarningAction { color: #94A3B8; font-size: 8.5pt; background: transparent; }
QSplitter::handle { background: #263244; width: 2px; }
QToolButton { background: #1F2937; border: 1px solid #374151; border-radius: 6px; padding: 8px 12px; }
QToolButton:checked { background: #F97316; color: #111827; border-color: #F97316; font-weight: 700; }

/* Dispatch Center v0.6 */
QWidget#dispatchPage { background: #0B1220; }
QFrame#dispatchMetric { background: #111827; border: 1px solid #263244; border-radius: 10px; }
QLabel#dispatchMetricValue { color: #FFFFFF; font-size: 18pt; font-weight: 800; background: transparent; }
QLabel#dispatchMetricLabel { color: #94A3B8; font-size: 8.5pt; font-weight: 600; background: transparent; }
QFrame#kanbanLane { background: #0F172A; border: 1px solid #263244; border-radius: 11px; }
QLabel#kanbanTitle { color: #F8FAFC; font-size: 11pt; font-weight: 750; background: transparent; }
QLabel#kanbanCount { color: #F97316; background: #1F2937; border: 1px solid #374151; border-radius: 10px; padding: 2px 7px; font-weight: 700; }
QFrame#dispatchJobCard { background: #111827; border: 1px solid #334155; border-left: 4px solid #64748B; border-radius: 9px; }
QFrame#dispatchJobCard:hover { border-color: #F97316; background: #172033; }
QFrame#dispatchJobCard[priority="high"] { border-left-color: #F59E0B; }
QFrame#dispatchJobCard[priority="urgent"] { border-left-color: #EF4444; }
QFrame#dispatchJobCard[priority="low"] { border-left-color: #38BDF8; }
QLabel#dispatchJobNumber { color: #F97316; font-size: 8.5pt; font-weight: 800; background: transparent; }
QLabel#dispatchPriority { color: #CBD5E1; font-size: 7.5pt; font-weight: 800; background: #1F2937; border-radius: 6px; padding: 2px 5px; }
QLabel#dispatchPriority[priority="urgent"] { color: #FCA5A5; background: #3F1518; }
QLabel#dispatchPriority[priority="high"] { color: #FCD34D; background: #3A2A0C; }
QLabel#dispatchCustomer { color: #F8FAFC; font-size: 10.5pt; font-weight: 750; background: transparent; }
QLabel#dispatchRoute, QLabel#dispatchSchedule, QLabel#dispatchAssignment { color: #94A3B8; font-size: 8.5pt; background: transparent; }
QLabel#dispatchAmount { color: #E2E8F0; font-weight: 700; background: transparent; }
QLabel#dispatchAlertCount { color: #64748B; font-size: 8pt; background: transparent; }
QLabel#dispatchAlertCount[hasAlerts="true"] { color: #F59E0B; font-weight: 700; }
QFrame#dispatchDetail { background: #111827; border: 1px solid #263244; border-radius: 12px; }
QLabel#sectionTitle { color: #CBD5E1; font-weight: 700; font-size: 9pt; background: transparent; }
QFrame#calendarLane { background: #0F172A; border: 1px solid #263244; border-radius: 10px; }
QLabel#calendarLaneTitle { color: #E2E8F0; font-weight: 750; font-size: 10pt; background: transparent; }
QLabel#calendarPeriod { color: #F8FAFC; font-weight: 750; font-size: 11pt; padding-left: 8px; }
QLabel#statusTransition { color: #F97316; font-size: 16pt; font-weight: 800; padding: 12px; }
QTabWidget::pane { border: 1px solid #263244; border-radius: 9px; background: #0B1220; }
QTabBar::tab { background: #111827; color: #94A3B8; border: 1px solid #263244; padding: 9px 15px; }
QTabBar::tab:selected { color: #F97316; background: #172033; border-bottom: 2px solid #F97316; }
QCalendarWidget QWidget { alternate-background-color: #111827; }
QCalendarWidget QAbstractItemView:enabled { background: #0F172A; color: #E5E7EB; selection-background-color: #F97316; selection-color: #111827; }

/* Navigation accessibility v0.6.1 */
QFrame#topNavigationBar {
    background: #111827;
    border-bottom: 1px solid #263244;
}
QPushButton#navigationToggle {
    background: #1F2937;
    color: #F8FAFC;
    border: 1px solid #374151;
    border-radius: 8px;
    font-size: 16pt;
    font-weight: 700;
    padding: 0;
}
QPushButton#navigationToggle:hover {
    background: #F97316;
    color: #111827;
    border-color: #F97316;
}
QPushButton#navigationToggle:pressed {
    background: #EA580C;
}
QLabel#sectionTitle {
    color: #F8FAFC;
    font-size: 12pt;
    font-weight: 750;
    background: transparent;
}

/* Invoice Management v0.8 */
QWidget#invoicePage { background: #0B1220; }
QWidget#invoicePage QGroupBox { background: #111827; border: 1px solid #334155; border-radius: 10px; margin-top: 10px; padding-top: 10px; }
QWidget#invoicePage QGroupBox::title { color: #F97316; subcontrol-origin: margin; left: 12px; padding: 0 5px; font-weight: 700; }
QWidget#invoicePage QTableWidget { background: #0F172A; alternate-background-color: #111827; border: 1px solid #334155; border-radius: 8px; gridline-color: #334155; }
QWidget#invoicePage QHeaderView::section { background: #111827; color: #CBD5E1; border: 0; border-bottom: 1px solid #334155; padding: 8px; font-weight: 700; }
QWidget#invoicePage QTableWidget::item:selected { background: #7C2D12; color: #FFFFFF; }
QWidget#invoicePage QTabBar::tab:selected { color: #F97316; border-bottom: 2px solid #F97316; }

/* Shared action semantics */
QPushButton#primaryButton,
QPushButton#primary {
    background: #F97316;
    color: #111827;
    border: 1px solid #F97316;
    font-weight: 700;
}
QPushButton#primaryButton:hover,
QPushButton#primary:hover { background: #FB923C; border-color: #FB923C; }
QPushButton#primaryButton:pressed,
QPushButton#primary:pressed { background: #EA580C; border-color: #EA580C; }
QPushButton#dangerButton,
QPushButton#danger {
    background: #3F1518;
    color: #FCA5A5;
    border: 1px solid #7F1D1D;
    font-weight: 700;
}
QPushButton#dangerButton:hover,
QPushButton#danger:hover { background: #521B20; border-color: #EF4444; }
QPushButton:disabled,
QToolButton:disabled {
    background: #172033;
    color: #64748B;
    border-color: #263244;
}
