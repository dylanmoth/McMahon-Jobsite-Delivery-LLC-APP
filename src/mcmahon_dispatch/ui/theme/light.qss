QWidget { background: #F3F4F6; color: #111827; font-family: "Segoe UI"; font-size: 10pt; }
QMainWindow, QDialog { background: #F3F4F6; }
QFrame#sidebar, QFrame#topbar { background: #FFFFFF; border-color: #D1D5DB; }
QFrame#sidebar { border-right: 1px solid #D1D5DB; }
QFrame#topbar { border-bottom: 1px solid #D1D5DB; }
QLabel#brandTitle, QLabel#pageTitle { color: #111827; font-weight: 700; }
QLabel#brandTitle { font-size: 16pt; }
QLabel#pageTitle { font-size: 20pt; }
QLabel#muted, QLabel#metricLabel { color: #6B7280; }
QPushButton { background: #FFFFFF; border: 1px solid #D1D5DB; border-radius: 6px; padding: 8px 12px; }
QPushButton:hover, QLineEdit:focus, QComboBox:focus { border-color: #F97316; }
QPushButton#primary { background: #F97316; color: #111827; border: none; font-weight: 700; }
QPushButton#navButton { border: none; text-align: left; padding: 10px 14px; background: transparent; }
QPushButton#navButton:hover, QPushButton#navButton[active="true"] { background: #FFF7ED; color: #C2410C; }
QLineEdit, QComboBox, QSpinBox { background: #FFFFFF; border: 1px solid #D1D5DB; border-radius: 6px; padding: 8px; }
QFrame#metricCard { background: #FFFFFF; border: 1px solid #D1D5DB; border-radius: 10px; }
QLabel#metricValue { font-size: 22pt; font-weight: 700; color: #111827; }
QStatusBar { background: #FFFFFF; color: #6B7280; }

/* Dashboard v0.3 */
QWidget#dashboardContent { background: #F3F4F6; }
QLabel#dashboardUpdated { color: #64748B; font-size: 9pt; }
QPushButton#secondaryCompact { padding: 7px 12px; border-radius: 8px; }
QFrame#metricCard { background: #FFFFFF; border: 1px solid #DDE3EA; border-radius: 12px; }
QFrame#metricCard:hover { border-color: #94A3B8; background: #FAFAFA; }
QFrame#metricAccent { border: none; border-top-left-radius: 12px; border-bottom-left-radius: 12px; background: #F97316; }
QFrame#metricAccent[accent="green"] { background: #16A34A; }
QFrame#metricAccent[accent="blue"] { background: #0284C7; }
QFrame#metricAccent[accent="amber"] { background: #D97706; }
QFrame#metricAccent[accent="red"] { background: #DC2626; }
QLabel#metricLabel { color: #64748B; font-weight: 600; font-size: 9pt; }
QLabel#metricValue { color: #0F172A; font-size: 22pt; font-weight: 700; }
QLabel#metricHelper { color: #94A3B8; font-size: 8.5pt; }
QFrame#dashboardPanel { background: #FFFFFF; border: 1px solid #DDE3EA; border-radius: 12px; }
QLabel#panelTitle { color: #0F172A; font-size: 12pt; font-weight: 700; }
QLabel#panelSubtitle { color: #64748B; font-size: 9pt; }
QPushButton#primaryAction { background: #F97316; color: #111827; border: none; border-radius: 9px; font-weight: 700; text-align: left; padding: 10px 14px; }
QPushButton#primaryAction:hover { background: #FB923C; }
QPushButton#quickAction { background: #F8FAFC; border: 1px solid #DDE3EA; border-radius: 9px; text-align: left; padding: 10px 14px; font-weight: 600; }
QPushButton#quickAction:hover { border-color: #F97316; background: #FFF7ED; }
QFrame#notificationRow { background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; }
QFrame#notificationRow:hover { border-color: #94A3B8; }
QLabel#notificationMarker { color: #0284C7; font-size: 10pt; }
QLabel#notificationMarker[severity="success"] { color: #16A34A; }
QLabel#notificationMarker[severity="warning"] { color: #D97706; }
QLabel#notificationMarker[severity="danger"] { color: #DC2626; }
QLabel#rowTitle { color: #1E293B; font-weight: 600; background: transparent; }
QLabel#rowSubtitle, QLabel#rowMeta { color: #64748B; font-size: 8.5pt; background: transparent; }
QPushButton#listRowButton { background: transparent; border: none; border-bottom: 1px solid #E2E8F0; border-radius: 0; text-align: left; padding: 0; }
QPushButton#listRowButton:hover { background: #F8FAFC; }
QFrame#activityRow { background: transparent; border-bottom: 1px solid #E2E8F0; }
QLabel#activityMarker { color: #F97316; font-size: 15pt; background: transparent; }
QLabel#emptyState { color: #64748B; background: transparent; }
QScrollArea { border: none; background: #F3F4F6; }
QScrollBar:vertical { background: #F3F4F6; width: 11px; margin: 0; }
QScrollBar::handle:vertical { background: #CBD5E1; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #94A3B8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* Quote Builder v0.5 */
QGroupBox { background: #FFFFFF; border: 1px solid #D1D5DB; border-radius: 10px; margin-top: 13px; padding: 14px 10px 10px 10px; font-weight: 700; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; color: #C2410C; }
QTextEdit, QPlainTextEdit, QDoubleSpinBox, QDateTimeEdit { background: #FFFFFF; color: #111827; border: 1px solid #CBD5E1; border-radius: 6px; padding: 7px; }
QFrame#quoteSummary, QFrame#quickNotesPanel { background: #FFFFFF; border: 1px solid #D1D5DB; border-radius: 12px; }
QLabel#quoteNumber { color: #C2410C; font-size: 12pt; font-weight: 700; }
QLabel#quoteTotal { color: #111827; font-size: 25pt; font-weight: 800; }
QFrame#quoteWarning { background: #F8FAFC; border: 1px solid #CBD5E1; border-radius: 8px; }
QFrame#quoteWarning[severity="warning"] { border-color: #F59E0B; background: #FFFBEB; }
QFrame#quoteWarning[severity="danger"] { border-color: #EF4444; background: #FEF2F2; }
QLabel#quoteWarningTitle { color: #111827; font-weight: 700; background: transparent; }
QLabel#quoteWarningAction { color: #64748B; font-size: 8.5pt; background: transparent; }

/* Dispatch Center v0.6 */
QWidget#dispatchPage { background: #F3F4F6; }
QFrame#dispatchMetric { background: #FFFFFF; border: 1px solid #D1D5DB; border-radius: 10px; }
QLabel#dispatchMetricValue { color: #111827; font-size: 18pt; font-weight: 800; background: transparent; }
QLabel#dispatchMetricLabel { color: #6B7280; font-size: 8.5pt; font-weight: 600; background: transparent; }
QFrame#kanbanLane { background: #F8FAFC; border: 1px solid #D1D5DB; border-radius: 11px; }
QLabel#kanbanTitle { color: #111827; font-size: 11pt; font-weight: 750; background: transparent; }
QLabel#kanbanCount { color: #EA580C; background: #FFF7ED; border: 1px solid #FED7AA; border-radius: 10px; padding: 2px 7px; font-weight: 700; }
QFrame#dispatchJobCard { background: #FFFFFF; border: 1px solid #D1D5DB; border-left: 4px solid #64748B; border-radius: 9px; }
QFrame#dispatchJobCard:hover { border-color: #F97316; background: #FFF7ED; }
QFrame#dispatchJobCard[priority="high"] { border-left-color: #F59E0B; }
QFrame#dispatchJobCard[priority="urgent"] { border-left-color: #DC2626; }
QFrame#dispatchJobCard[priority="low"] { border-left-color: #0284C7; }
QLabel#dispatchJobNumber { color: #EA580C; font-size: 8.5pt; font-weight: 800; background: transparent; }
QLabel#dispatchPriority { color: #374151; font-size: 7.5pt; font-weight: 800; background: #F3F4F6; border-radius: 6px; padding: 2px 5px; }
QLabel#dispatchPriority[priority="urgent"] { color: #991B1B; background: #FEE2E2; }
QLabel#dispatchPriority[priority="high"] { color: #92400E; background: #FEF3C7; }
QLabel#dispatchCustomer { color: #111827; font-size: 10.5pt; font-weight: 750; background: transparent; }
QLabel#dispatchRoute, QLabel#dispatchSchedule, QLabel#dispatchAssignment { color: #6B7280; font-size: 8.5pt; background: transparent; }
QLabel#dispatchAmount { color: #1F2937; font-weight: 700; background: transparent; }
QLabel#dispatchAlertCount { color: #9CA3AF; font-size: 8pt; background: transparent; }
QLabel#dispatchAlertCount[hasAlerts="true"] { color: #D97706; font-weight: 700; }
QFrame#dispatchDetail { background: #FFFFFF; border: 1px solid #D1D5DB; border-radius: 12px; }
QLabel#sectionTitle { color: #374151; font-weight: 700; font-size: 9pt; background: transparent; }
QFrame#calendarLane { background: #F8FAFC; border: 1px solid #D1D5DB; border-radius: 10px; }
QLabel#calendarLaneTitle { color: #1F2937; font-weight: 750; font-size: 10pt; background: transparent; }
QLabel#calendarPeriod { color: #111827; font-weight: 750; font-size: 11pt; padding-left: 8px; }
QLabel#statusTransition { color: #EA580C; font-size: 16pt; font-weight: 800; padding: 12px; }
QTabWidget::pane { border: 1px solid #D1D5DB; border-radius: 9px; background: #F9FAFB; }
QTabBar::tab { background: #F3F4F6; color: #6B7280; border: 1px solid #D1D5DB; padding: 9px 15px; }
QTabBar::tab:selected { color: #EA580C; background: #FFFFFF; border-bottom: 2px solid #F97316; }
QCalendarWidget QAbstractItemView:enabled { background: #FFFFFF; color: #111827; selection-background-color: #F97316; selection-color: #111827; }

/* Navigation accessibility v0.6.1 */
QFrame#topNavigationBar {
    background: #FFFFFF;
    border-bottom: 1px solid #D1D5DB;
}
QPushButton#navigationToggle {
    background: #F3F4F6;
    color: #111827;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    font-size: 16pt;
    font-weight: 700;
    padding: 0;
}
QPushButton#navigationToggle:hover {
    background: #F97316;
    color: #111827;
    border-color: #F97316;
}
QPushButton#navigationToggle:pressed {
    background: #EA580C;
}
QLabel#sectionTitle {
    color: #111827;
    font-size: 12pt;
    font-weight: 750;
    background: transparent;
}
